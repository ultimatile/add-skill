#!/bin/bash
#
# add-skill - Install skills from a local repository to a project directory
#
# Usage:
#   add-skill <skills-repo-path> [options]
#   add-skill --install
#   add-skill --help
#
# Environment Variables:
#   SKILLS_INSTALL_PATH  Custom installation path (default: $PWD/.claude/skills)

set -e

VERSION="0.7.0"

# Colors for output, gated per stream. One shared gate cannot serve both: with
# stdout on a terminal and stderr redirected to a file, a gate on [ -t 1 ] lets
# print_error write escapes into that file, and a gate on [ -t 2 ] loses the
# color on the terminal stdout instead. Gating on both at once is safe but
# drops the color whenever the two streams differ, so they are separate.
#
# NO_COLOR is checked with ${NO_COLOR-}, not ${NO_COLOR+set}: no-color.org
# disables color when the variable is "present and not an empty string", so an
# empty value leaves it on. That standard says nothing about terminals, which
# is why the two conditions are independent rather than one test.
#
# $'...' rather than '\033', so these hold a real escape character and the
# message functions below need no interpretation pass to emit them.
if [ -t 1 ] && [ -z "${NO_COLOR-}" ]; then
  OUT_GREEN=$'\033[0;32m'
  OUT_NC=$'\033[0m'
else
  OUT_GREEN=''
  OUT_NC=''
fi
if [ -t 2 ] && [ -z "${NO_COLOR-}" ]; then
  ERR_RED=$'\033[0;31m'
  ERR_YELLOW=$'\033[1;33m'
  ERR_NC=$'\033[0m'
else
  ERR_RED=''
  ERR_YELLOW=''
  ERR_NC=''
fi

# Expand a leading ~ to $HOME. Environment variables assigned with quotes
# (e.g. CLAUDE_CONFIG_DIR="~/.claude_fn") are not tilde-expanded by the shell,
# so relative-to-home config dirs must be normalized before use.
expand_tilde() {
  local path="$1"
  case "$path" in
  "~") echo "$HOME" ;;
  "~/"*) echo "$HOME/${path#\~/}" ;;
  *) echo "$path" ;;
  esac
}

# Default installation paths
DEFAULT_INSTALL_PATH="$PWD/.claude/skills"
# Claude Code honors CLAUDE_CONFIG_DIR to relocate the user-level config
# directory (default ~/.claude). Global skills live under its skills/ subdir,
# so --global must follow the same override rather than assuming ~/.claude.
CLAUDE_CONFIG_DIR="$(expand_tilde "${CLAUDE_CONFIG_DIR:-$HOME/.claude}")"
GLOBAL_INSTALL_PATH="$CLAUDE_CONFIG_DIR/skills"
# Codex discovers skills under .agents/skills at both user and repository scope;
# ~/.codex holds only config.toml, not skills.
# See https://learn.chatgpt.com/docs/build-skills
CODEX_INSTALL_PATH="$HOME/.agents/skills"
CODEX_REPO_INSTALL_PATH="$PWD/.agents/skills"
KIRO_INSTALL_PATH="$HOME/.kiro/skills"
KIRO_REPO_INSTALL_PATH="$PWD/.kiro/skills"
INSTALL_PATH="$DEFAULT_INSTALL_PATH"
USE_GLOBAL_PATH=false
USE_CODEX_PATH=false
USE_CODEX_REPO_PATH=false
USE_KIRO_PATH=false
USE_KIRO_REPO_PATH=false
USE_FORCE=false
# Set by install_skill when --force actually removed a real entry, so the
# closing summary reports what happened rather than what was passed.
REPLACED_REAL=false

# How much a successful run says. Set before the argument parser runs, because
# print_error is reachable from inside it. quiet suppresses print_info and
# nothing else: a warning about a deletion is worth more noise than silence.
VERBOSITY=normal

# What the normal level reports once, at exit. Appended to only after ln -s
# returns, so a skill that failed is never named as installed.
INSTALLED_NAMES=""
INSTALLED_COUNT=0
FORCED_NAMES=""

# Skills source (set from first positional argument)
SKILLS_SOURCE_DIR=""

# Single-skill repo mode: true when the repo root itself contains SKILL.md
SINGLE_SKILL_REPO=false
SINGLE_SKILL_NAME=""
SINGLE_SKILL_PATH=""

# Marketplace mode: true when .claude-plugin/marketplace.json is found
MARKETPLACE_MODE=false
MARKETPLACE_SKILL_PATHS=()
MARKETPLACE_SKILL_NAMES=()

# Skills to install
INSTALL_ALL=true
SPECIFIC_SKILLS=()

# Self-install flag
DO_SELF_INSTALL=false

# Functions
# printf, not echo -e. Every one of these messages interpolates a path or a
# skill name, and echo -e interprets backslash sequences anywhere in its
# argument: a source repository holding a skill directory named
# lit\033[31mRED -- a backslash, 033, then the rest, all legal in a filename --
# installs fine and writes a real escape byte wherever the message lands. With
# %s the message is inert and the constants above are the only source of one.
print_info() {
  [ "$VERBOSITY" = quiet ] && return 0
  printf '%s[INFO]%s %s\n' "$OUT_GREEN" "$OUT_NC" "$1"
}

# A blank line that spaces informational output, so it goes when that goes.
# Gating the message functions alone would leave these behind and the quiet
# level would still write to stdout.
print_blank() {
  [ "$VERBOSITY" = quiet ] && return 0
  echo ""
}

# Only the verbose level prints per-skill progress and the closing block.
verbose_info() {
  [ "$VERBOSITY" = verbose ] || return 0
  print_info "$1"
}

verbose_blank() {
  [ "$VERBOSITY" = verbose ] || return 0
  echo ""
}

# What the normal level prints instead of the per-skill pair, from an EXIT trap
# rather than after the loop. install_skill is called as a bare command, so
# under set -e a failure aborts the script at that call and nothing placed
# after the loop runs — a run that linked twenty of thirty-five skills would
# report the failure and say nothing about the twenty it had already replaced.
#
# Ends in return 0. The last conditional is false whenever nothing was
# replaced, and the trap should not take its status from that.
flush_summary() {
  [ "$VERBOSITY" = normal ] || return 0
  [ -n "$INSTALLED_NAMES" ] || return 0
  print_info "Symlinked $INSTALLED_COUNT skills:$INSTALLED_NAMES"
  [ -n "$FORCED_NAMES" ] && print_info "Replaced a real file or directory for:$FORCED_NAMES"
  return 0
}
# Fires on every exit, --help and --list included; the emptiness check above is
# what keeps those silent, rather than an assumption about when the trap runs.
trap flush_summary EXIT

# Diagnostics go to stderr so that redirecting stdout away — to drop the
# install log, or to capture it — keeps the reason a run failed visible.
print_warn() {
  printf '%s[WARN]%s %s\n' "$ERR_YELLOW" "$ERR_NC" "$1" >&2
}

print_error() {
  printf '%s[ERROR]%s %s\n' "$ERR_RED" "$ERR_NC" "$1" >&2
}

# True when the first resolved path is the second or sits inside it. An empty
# argument means that path could not be resolved, which is inside nothing.
path_within() {
  local inner=$1 outer=$2
  if [ -z "$inner" ] || [ -z "$outer" ]; then
    return 1
  fi
  # The root directory is spelled "/", so appending a separator below would give
  # the pattern //* and match nothing beneath it. Strip a trailing separator
  # from both sides first; "/" then becomes "" and /* matches every path.
  outer="${outer%/}"
  inner="${inner%/}"
  # A leading double separator is implementation-defined in POSIX but names the
  # same directory on the systems this runs on. Collapse it too: this decides
  # whether a removal may proceed, and treating two paths as related when they
  # might not be only ever refuses an install, while missing a relation deletes.
  while [ "${inner#//}" != "$inner" ]; do inner="${inner#/}"; done
  while [ "${outer#//}" != "$outer" ]; do outer="${outer#/}"; done
  if [ "$inner" = "$outer" ]; then
    return 0
  fi
  case "$inner/" in "$outer"/*) return 0 ;; esac
  return 1
}

# True when the first path, or an ancestor of it, is the same file as the
# second. Text cannot settle this: two paths can name one directory with no
# resolver unifying them. A Linux bind mount is the plain case — mount --bind
# leaves both spellings intact and pwd -P canonicalizes neither onto the
# other — and -ef compares device and inode instead. It follows symlinks, so
# the caller must only ask about a destination that would be removed
# recursively.
path_under_identity() {
  local inner=$1 outer=$2
  if [ -z "$inner" ] || [ -z "$outer" ] || [ ! -e "$outer" ]; then
    return 1
  fi
  local cur=$inner prev=''
  while [ "$cur" != "$prev" ]; do
    if [ -e "$cur" ] && [ "$cur" -ef "$outer" ]; then
      return 0
    fi
    prev=$cur
    cur="${cur%/*}"
    [ -z "$cur" ] && cur="/"
  done
  return 1
}

show_help() {
  cat <<'EOF'
add-skill - Install skills from a local repository to a project directory

Usage:
  add-skill <skills-repo-path> [options]
  add-skill --install
  add-skill --help

Arguments:
  <skills-repo-path>    Path to a local skills repository containing a skills/ directory

Options:
  --help              Show this help message
  --version, -V       Show version
  --install           Install add-skill itself to ~/.local/bin (symlink)
  --list              List available skills in the repository
  --quiet, -q         Print nothing on success; warnings and errors still show
  --verbose, -v       Print a line per skill instead of one summary line
  --all               Install all skills (default)
  --skill <name>      Install specific skill(s) (can be used multiple times)
  --force             Allow replacing a real file or directory at the destination
  --global            Install to Claude Code global skills path (~/.claude/skills, or $CLAUDE_CONFIG_DIR/skills if set)
  --codex             Install to Codex global skills path (~/.agents/skills)
  --codex-repo        Install to Codex repository-level path (./.agents/skills)
  --kiro              Install to Kiro global skills path (~/.kiro/skills)
  --kiro-repo         Install to Kiro repository-level path (./.kiro/skills)

Environment Variables:
  SKILLS_INSTALL_PATH  Custom installation path (default: $PWD/.claude/skills, ~/.claude/skills with --global, ~/.agents/skills with --codex, ./.agents/skills with --codex-repo, ~/.kiro/skills with --kiro, or ./.kiro/skills with --kiro-repo)
  CLAUDE_CONFIG_DIR    Claude Code user config directory (default: ~/.claude); --global installs to its skills/ subdirectory
  NO_COLOR             Set to any non-empty value to disable colored output (no-color.org)

Color is also disabled on a stream that is not a terminal, so a redirected
run records no escape sequences whether or not NO_COLOR is set.

Examples:
  # Install add-skill command to PATH
  add-skill --install

  # List available skills in a repository
  add-skill ~/my-skills-repo --list

  # Install all skills from a repository
  add-skill ~/my-skills-repo

  # Install all skills, allowing replacement of a real file or directory
  add-skill ~/my-skills-repo --force --all

  # Install specific skills
  add-skill ~/my-skills-repo --skill my-skill --skill another-skill

  # Install to custom path
  SKILLS_INSTALL_PATH=/path/to/project/.claude/skills add-skill ~/my-skills-repo

  # Install for Claude Code (global)
  add-skill ~/my-skills-repo --global --all

  # Install for Codex (global)
  add-skill ~/my-skills-repo --codex --all

  # Install for Codex (repository-level)
  add-skill ~/my-skills-repo --codex-repo --all

  # Install for Kiro (global)
  add-skill ~/my-skills-repo --kiro --all

  # Install for Kiro (repository-level)
  add-skill ~/my-skills-repo --kiro-repo --all


  Skills are installed as symlinks to the source repository, so an edit there
  is live in every project that installed from it. A symlink left by an earlier
  install is replaced, and is unlinked rather than followed. A real file or
  directory at the destination is refused unless --force is passed. Nothing
  asks for confirmation: if the install cannot be made, the run reports the
  reason on stderr and stops. Warnings and errors go to stderr at every
  verbosity level, so redirecting stdout away keeps them.

  Codex skill locations (in search order; same-name skills are not merged,
  so both can appear in the skill selector):
    --codex-repo: ./.agents/skills (repository-level, searched first)
    --codex:      ~/.agents/skills (user-level, searched later)

  Kiro skill locations (in order of precedence):
    --kiro-repo:  ./.kiro/skills  (repository-level, highest precedence)
    --kiro:       ~/.kiro/skills  (user-level, lower precedence)

EOF
}

# Whether add-skill ended up on PATH is worth saying however it got to
# $install_dir, including when it was already there and nothing was installed.
report_path_state() {
  local install_dir=$1
  if echo "$PATH" | tr ':' '\n' | grep -Fqx "$install_dir"; then
    print_info "add-skill is now available in your PATH"
    return 0
  fi
  # One message, so one stream. The blank line above the warning and the
  # configuration block below it are as much a part of it as the warning
  # itself, and splitting them would leave half on stdout.
  {
    echo ""
    print_warn "$install_dir is not in your PATH"
    echo "  Add the following to your shell configuration:"
    echo ""
    echo "  # For bash (~/.bashrc):"
    echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "  # For zsh (~/.zshrc):"
    echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "  # For fish (~/.config/fish/config.fish):"
    echo "  fish_add_path \$HOME/.local/bin"
    echo ""
  } >&2
}

# Install add-skill itself to ~/.local/bin
self_install() {
  local script_path
  # Resolve symlinks to get the real path, avoiding self-referencing symlink
  # when running via an already-installed symlink
  script_path="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)/$(basename "$(realpath "${BASH_SOURCE[0]}")")"
  local install_dir="$HOME/.local/bin"
  local install_path="$install_dir/add-skill"

  print_info "Installing add-skill to $install_path..."

  if ! mkdir -p "$install_dir"; then
    print_error "Failed to create $install_dir"
    return 1
  fi

  # Resolving the earlier symlink keeps a symlinked install from pointing at
  # itself, but the script can also be the real file sitting at the destination.
  # Then the removal below would delete it and the link would point at nothing.
  # Compare resolved paths: /tmp and /private/tmp name one directory on macOS,
  # so the two unresolved strings can differ while naming the same file.
  if ! (cd "$install_dir" 2>/dev/null); then
    print_error "Failed to enter $install_dir"
    return 1
  fi
  # -ef compares device and inode, so the two spellings a firmlink gives one
  # directory still read as the same file.
  if [ -e "$install_path" ] && [ "$script_path" -ef "$install_path" ]; then
    print_info "add-skill already lives at $install_path; leaving it as it is"
    report_path_state "$install_dir"
    return 0
  fi

  # A real file here is replaced unasked, where a skill destination gates that
  # behind a flag. What differs is what the two can hold: a skill destination
  # is any name under the install path, so something else may have written it,
  # while this is one fixed path whose only expected occupant is add-skill
  # itself — and the -ef check above already returns before touching the copy
  # that is this script.
  if [ -e "$install_path" ] || [ -L "$install_path" ]; then
    print_warn "Removing existing: $install_path"
    if ! rm -f "$install_path"; then
      print_error "Failed to remove the existing $install_path"
      return 1
    fi
  fi

  if ! ln -s "$script_path" "$install_path"; then
    print_error "Failed to symlink add-skill to $install_path"
    return 1
  fi
  print_info "Symlinked: $install_path -> $script_path"

  report_path_state "$install_dir"
}

# The entries are what --list was asked for, so they survive the quiet level.
# The header and the blanks spacing them are decoration and do not, which
# leaves `--list --quiet` a listing a caller can read straight through.
list_available_skills() {
  print_blank
  print_info "Available skills in $SKILLS_SOURCE_DIR:"
  print_blank

  # Marketplace mode: list skills from marketplace.json
  if [ "$MARKETPLACE_MODE" = true ]; then
    for i in "${!MARKETPLACE_SKILL_NAMES[@]}"; do
      local skill_name="${MARKETPLACE_SKILL_NAMES[$i]}"
      local skill_path="${MARKETPLACE_SKILL_PATHS[$i]}"
      if [ -f "$skill_path/SKILL.md" ]; then
        local description
        description=$(awk '/^---$/,/^---$/{if(/^description:/) {sub(/^description: */, ""); print; exit}}' "$skill_path/SKILL.md")
        echo "  • $skill_name"
        [ -n "$description" ] && echo "    $description"
      else
        echo "  • $skill_name (SKILL.md not found)"
      fi
    done
    print_blank
    return 0
  fi

  # Single-skill repo: the repo root itself is the skill
  if [ "$SINGLE_SKILL_REPO" = true ]; then
    local description
    description=$(awk '/^---$/,/^---$/{if(/^description:/) {sub(/^description: */, ""); print; exit}}' "$SINGLE_SKILL_PATH/SKILL.md")
    echo "  • $SINGLE_SKILL_NAME"
    [ -n "$description" ] && echo "    $description"
    print_blank
    return 0
  fi

  if [ ! -d "$SKILLS_SOURCE_DIR" ]; then
    print_error "Skills directory not found: $SKILLS_SOURCE_DIR"
    return 1
  fi

  local found=false
  for skill_dir in "$SKILLS_SOURCE_DIR"/*/; do
    if [ -d "$skill_dir" ]; then
      # Not basename: command substitution strips a trailing newline, and a
      # directory name may end in one.
      local trimmed="${skill_dir%/}"
      local skill_name="${trimmed##*/}"
      if [ -f "$skill_dir/SKILL.md" ]; then
        # Extract description from YAML frontmatter if available
        local description=$(awk '/^---$/,/^---$/{if(/^description:/) {sub(/^description: */, ""); print; exit}}' "$skill_dir/SKILL.md")
        if [ -n "$description" ]; then
          echo "  • $skill_name"
          echo "    $description"
        else
          echo "  • $skill_name"
        fi
        found=true
      fi
    fi
  done

  # The closing blank belongs to whatever it closes: the listing on stdout,
  # or the warning that replaced it on stderr.
  if [ "$found" = false ]; then
    print_warn "No skills found (no SKILL.md files)"
    echo "" >&2
  else
    print_blank
  fi
}

# Returns non-zero when the skill could not be installed. Callers must stay bare
# commands: set -e ignores a failure in a condition, on the left of && or ||,
# under !, or anywhere but the end of a pipeline, and that abort is the only
# thing turning this non-zero into the documented "reports the reason and
# stops".
install_skill() {
  # A --skill argument arrives as typed, and shell completion appends a slash to
  # a directory name. Strip it here so the source path, the destination and the
  # messages all name the same thing.
  local skill_name=$1
  while [ "${skill_name%/}" != "$skill_name" ]; do
    skill_name="${skill_name%/}"
  done

  # A skill name names a directory directly under the source's skills/, which
  # is the only level discovery walks. A path component would send both the
  # source and the destination somewhere else: --skill ../x installs outside
  # the install path and clears whatever was there.
  case "$skill_name" in
  "" | "." | "..")
    print_error "Not a skill name: $1"
    return 1
    ;;
  */*)
    print_error "A skill name cannot contain a path component: $1"
    return 1
    ;;
  esac
  local source_path
  # Resolve source path based on discovery mode
  if [ "$MARKETPLACE_MODE" = true ]; then
    for i in "${!MARKETPLACE_SKILL_NAMES[@]}"; do
      if [ "${MARKETPLACE_SKILL_NAMES[$i]}" = "$skill_name" ]; then
        source_path="${MARKETPLACE_SKILL_PATHS[$i]}"
        break
      fi
    done
    if [ -z "$source_path" ]; then
      print_error "Skill '$skill_name' not found in marketplace.json"
      return 1
    fi
  elif [ "$SINGLE_SKILL_REPO" = true ]; then
    source_path="$SINGLE_SKILL_PATH"
  else
    source_path="$SKILLS_SOURCE_DIR/$skill_name"
  fi
  local dest_path="$INSTALL_PATH/$skill_name"

  if [ ! -d "$source_path" ]; then
    print_error "Skill not found: $skill_name"
    return 1
  fi

  # Create destination directory
  if ! mkdir -p "$INSTALL_PATH"; then
    print_error "Failed to create $INSTALL_PATH for $skill_name"
    return 1
  fi

  # Normalize the destination once and work from it below. dirname absorbs any
  # path components a --skill argument carried and strips a trailing slash, and
  # resolving the parent settles a relative path or a .. component. The final
  # component stays unresolved so a symlinked destination is still the link.
  local dest_entry dest_parent
  local dest_dir="${dest_path%/*}"
  [ -z "$dest_dir" ] && dest_dir="/"
  dest_parent="$(cd "$dest_dir" 2>/dev/null && pwd -P)" || dest_parent=""
  if [ -n "$dest_parent" ]; then
    # ${dest_parent%/} because a parent of "/" would otherwise join to //name.
    # path_within collapses that too, so either half closes the hole; this one
    # keeps dest_entry canonical for the removal and the link, and is the only
    # one no test covers, since reaching it needs an install path of "/".
    # ${x##*/} rather than basename: command substitution strips every
    # trailing newline, and a filename may end in one, which would silently
    # retarget this at the sibling of that name.
    dest_entry="${dest_parent%/}/${dest_path##*/}"
  else
    dest_entry="$dest_path"
  fi

  # The removal below runs before the link, so it must not reach the
  # source. Rather than enumerating the path shapes that could name the source,
  # bound the relation: what matters is whether the source lies inside what is
  # about to be removed. The other direction — a destination inside the source,
  # which is what installing a single-skill repo into its own .claude/skills
  # does — is safe, because the removal only touches the destination itself.
  #
  # Compare every entry the source resolves through, not just its ends: the
  # destination can be a link in the middle, and unlinking it there leaves the
  # source pointing at what this then creates — a cycle, reported as success.
  # Walked inline rather than through a helper that lists the chain, because a
  # filename may contain a newline and any line-delimited list would split it.
  #
  # Resolve both sides the same way. cd plus pwd -P agrees with itself, while
  # realpath returns whichever spelling it was handed, so mixing the two put
  # one directory in two namespaces. That alone is not enough, though: a bind
  # mount gives a directory two paths that no resolver unifies at all, which
  # is what the identity comparison below is for.
  local node="$source_path" node_dir node_parent link depth=0
  while :; do
    node_dir="${node%/*}"
    [ -z "$node_dir" ] && node_dir="/"
    node_parent="$(cd "$node_dir" 2>/dev/null && pwd -P)" || break
    node="${node_parent%/}/${node##*/}"
    # Compared as soon as it is formed, so no exit below can leave an entry
    # unexamined — including the target the last link resolves to.
    if path_within "$node" "$dest_entry"; then
      print_error "Refusing to install $skill_name: $dest_path is or contains its own source $source_path"
      return 1
    fi
    # Identity as well, and only when the destination is a real entry, which
    # is what the removal recurses into. A symlink there is unlinked, so
    # nothing behind it is at risk — and -ef would follow it straight back to
    # the source and refuse every ordinary reinstall.
    if [ ! -L "$dest_entry" ] && [ -e "$dest_entry" ] && path_under_identity "$node" "$dest_entry"; then
      print_error "Refusing to install $skill_name: $dest_path is another name for its own source $source_path"
      return 1
    fi
    [ -L "$node" ] || break
    depth=$((depth + 1))
    if [ "$depth" -gt 40 ]; then
      # Not reachable through a chain the kernel already resolved for test -d,
      # which caps first. Kept because a walk bug should stop, not spin.
      print_error "Refusing to install $skill_name: $source_path resolves through more links than this will follow"
      return 1
    fi
    link="$(readlink "$node")" || break
    case "$link" in
    /*) node=$link ;;
    *) node="${node_parent%/}/$link" ;;
    esac
  done

  # Clear the destination. A symlink is unlinked, never recursed into: rm -rf
  # reaches through one only when the path carries a trailing slash, which the
  # normalization above strips, and unlinking says so rather than leaning on
  # that. Anything else is a real file or directory. The only thing this ever
  # creates here is a symlink, so replacing a real entry is opt-in.
  local forced=""
  if [ -L "$dest_entry" ]; then
    if ! rm -f "$dest_entry"; then
      print_error "Failed to remove the existing $skill_name at $dest_path"
      return 1
    fi
  elif [ -e "$dest_entry" ]; then
    if [ "$USE_FORCE" != true ]; then
      print_error "$dest_path already exists and is not a symlink; pass --force to replace it"
      return 1
    fi
    print_warn "Deleting the real file or directory at $dest_path"
    if ! rm -rf "$dest_entry"; then
      print_error "Failed to remove the existing $skill_name at $dest_path"
      return 1
    fi
    # Set here rather than from the flag: --force over an absent or symlinked
    # destination replaces nothing, and these mark what happened.
    forced=" (forced)"
    REPLACED_REAL=true
  fi

  verbose_info "Creating symlink for $skill_name..."

  # No -f. The removal above is what makes this correct, and -f cannot stand in
  # for it: with a real directory at the destination ln descends into it and
  # exits 0 either way, leaving the link inside it.
  #
  # ln writes its own reason to stderr, so this does not restate it.
  if ! ln -s "$source_path" "$dest_entry"; then
    print_error "Failed to symlink $skill_name to $dest_path"
    return 1
  fi
  verbose_info "✓ Symlinked $skill_name$forced: $dest_path -> $source_path"

  # After the link, not before: an abort between the two would otherwise leave
  # the summary naming a skill that never got installed.
  #
  # Through printf %q, because a skill name may hold a newline — the suite
  # installs one that does — and a raw expansion would break the summary across
  # physical lines and blur the boundary between two names containing spaces.
  # %q emits no trailing newline of its own, so the command substitution that
  # reads it strips nothing; the hazard list_available_skills guards against
  # with ${trimmed##*/} does not reach here.
  INSTALLED_NAMES="$INSTALLED_NAMES $(printf '%q' "$skill_name")"
  INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
  if [ -n "$forced" ]; then
    FORCED_NAMES="$FORCED_NAMES $(printf '%q' "$skill_name")"
  fi
}

# Parse arguments
DO_LIST=false
while [[ $# -gt 0 ]]; do
  case $1 in
  --help)
    show_help
    exit 0
    ;;
  --version | -V)
    echo "add-skill $VERSION"
    exit 0
    ;;
  --quiet | -q)
    VERBOSITY=quiet
    shift
    ;;
  --verbose | -v)
    VERBOSITY=verbose
    shift
    ;;
  --install)
    DO_SELF_INSTALL=true
    shift
    ;;
  --list)
    DO_LIST=true
    shift
    ;;
  --all)
    INSTALL_ALL=true
    shift
    ;;
  --force)
    USE_FORCE=true
    shift
    ;;
  --global)
    USE_GLOBAL_PATH=true
    shift
    ;;
  --codex)
    USE_CODEX_PATH=true
    shift
    ;;
  --codex-repo)
    USE_CODEX_REPO_PATH=true
    shift
    ;;
  --kiro)
    USE_KIRO_PATH=true
    shift
    ;;
  --kiro-repo)
    USE_KIRO_REPO_PATH=true
    shift
    ;;
  --skill)
    INSTALL_ALL=false
    if [ -z "$2" ] || [[ "$2" == --* ]]; then
      print_error "--skill requires a skill name"
      exit 1
    fi
    SPECIFIC_SKILLS+=("$2")
    shift 2
    ;;
  -*)
    print_error "Unknown option: $1"
    # Usage shown because the run failed, so it goes where the error went.
    # `--help` above still writes to stdout, where it was asked for.
    {
      echo ""
      show_help
    } >&2
    exit 1
    ;;
  *)
    # Positional argument: skills repo path
    if [ -z "$SKILLS_SOURCE_DIR" ]; then
      repo_root="$(cd "$1" 2>/dev/null && pwd)" || {
        print_error "Invalid path: $1"
        exit 1
      }
      # Priority: marketplace.json > SKILL.md at root > skills/ directory
      if [ -f "$repo_root/.claude-plugin/marketplace.json" ]; then
        MARKETPLACE_MODE=true
        SKILLS_SOURCE_DIR="$repo_root"
        while IFS= read -r skill_path; do
          abs_path="$repo_root/${skill_path#./}"
          MARKETPLACE_SKILL_PATHS+=("$abs_path")
          trimmed_path="${abs_path%/}"
          MARKETPLACE_SKILL_NAMES+=("${trimmed_path##*/}")
        done < <(jq -r '.plugins[].skills[]' "$repo_root/.claude-plugin/marketplace.json")
      elif [ -f "$repo_root/SKILL.md" ]; then
        SINGLE_SKILL_REPO=true
        SINGLE_SKILL_NAME="${repo_root##*/}"
        SINGLE_SKILL_PATH="$repo_root"
        SKILLS_SOURCE_DIR="$repo_root"
      else
        SKILLS_SOURCE_DIR="$repo_root/skills"
      fi
    else
      print_error "Unexpected argument: $1"
      exit 1
    fi
    shift
    ;;
  esac
done

# Handle self-install
if [ "$DO_SELF_INSTALL" = true ]; then
  self_install
  exit 0
fi

# Require skills repo path for all other operations
if [ -z "$SKILLS_SOURCE_DIR" ]; then
  print_error "Missing required argument: <skills-repo-path>"
  {
    echo ""
    echo "Usage: add-skill <skills-repo-path> [options]"
    echo "       add-skill --install"
    echo "       add-skill --help"
  } >&2
  exit 1
fi

# Handle --list
if [ "$DO_LIST" = true ]; then
  list_available_skills
  exit 0
fi

# Resolve installation path after parsing flags/environment
if [ "$USE_GLOBAL_PATH" = true ]; then
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$GLOBAL_INSTALL_PATH}"
elif [ "$USE_CODEX_PATH" = true ]; then
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$CODEX_INSTALL_PATH}"
elif [ "$USE_CODEX_REPO_PATH" = true ]; then
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$CODEX_REPO_INSTALL_PATH}"
elif [ "$USE_KIRO_PATH" = true ]; then
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$KIRO_INSTALL_PATH}"
elif [ "$USE_KIRO_REPO_PATH" = true ]; then
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$KIRO_REPO_INSTALL_PATH}"
else
  INSTALL_PATH="${SKILLS_INSTALL_PATH:-$DEFAULT_INSTALL_PATH}"
fi

# Main installation
print_info "Source: $SKILLS_SOURCE_DIR"
print_info "Destination: $INSTALL_PATH"
verbose_blank

# Check if source directory exists
if [ ! -d "$SKILLS_SOURCE_DIR" ]; then
  print_error "Skills source directory not found: $SKILLS_SOURCE_DIR"
  echo "  Make sure the repository has a skills/ directory" >&2
  exit 1
fi

# Install selected skills
if [ "$INSTALL_ALL" = true ]; then
  verbose_info "Installing all skills..."
  verbose_blank

  if [ "$MARKETPLACE_MODE" = true ]; then
    # Marketplace mode: install skills listed in marketplace.json
    for skill_name in "${MARKETPLACE_SKILL_NAMES[@]}"; do
      install_skill "$skill_name"
    done
  elif [ "$SINGLE_SKILL_REPO" = true ]; then
    # Single-skill repo: install the one skill at the repo root
    install_skill "$SINGLE_SKILL_NAME"
  else
    # Find all directories with SKILL.md
    skill_count=0
    for skill_dir in "$SKILLS_SOURCE_DIR"/*/; do
      if [ -d "$skill_dir" ]; then
        trimmed="${skill_dir%/}"
        skill_name="${trimmed##*/}"
        if [ -f "$skill_dir/SKILL.md" ]; then
          install_skill "$skill_name"
          skill_count=$((skill_count + 1))
        else
          print_warn "Skipping $skill_name (no SKILL.md found)"
        fi
      fi
    done

    if [ $skill_count -eq 0 ]; then
      print_error "No valid skills found in $SKILLS_SOURCE_DIR"
      exit 1
    fi
  fi
else
  # Install specific skills
  if [ ${#SPECIFIC_SKILLS[@]} -eq 0 ]; then
    print_error "No skills specified. Use --skill <name> or --all"
    exit 1
  fi

  # In single-skill mode, ignore --skill names and install the repo's own skill
  if [ "$SINGLE_SKILL_REPO" = true ]; then
    install_skill "$SINGLE_SKILL_NAME"
  else
    for skill_name in "${SPECIFIC_SKILLS[@]}"; do
      install_skill "$skill_name"
    done
  fi
fi

# The closing block restates the two paths the header already gave, so only the
# verbose level keeps it. At the normal level flush_summary is what reports the
# run, and it names the skills as well, so printing the arrow too would say the
# same thing twice.
verbose_blank
verbose_info "Skills installed to: $INSTALL_PATH"
verbose_blank
verbose_info "Skills are symlinked from: $SKILLS_SOURCE_DIR"
if [ "$VERBOSITY" = verbose ] && [ "$REPLACED_REAL" = true ]; then
  echo "  → Replaced a real file or directory at the destination"
fi
verbose_blank
